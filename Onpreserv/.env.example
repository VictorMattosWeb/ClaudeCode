# Variáveis de ambiente do onPreserv.
#
# Copie este arquivo para `.env` e preencha os valores. O `.env` NUNCA é
# versionado — cada máquina e cada ambiente de deploy tem o seu.
#
# No Vercel/Netlify, cadastre estas mesmas três variáveis no painel do projeto
# (Settings -> Environment Variables). O prefixo VITE_ é obrigatório: só as
# variáveis com ele são embutidas no bundle pelo Vite.

# Identificador do projeto no Supabase.
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Chave publishable (anon). É feita para ficar no cliente: vai embutida no
# bundle de qualquer forma, e quem protege os dados é a RLS, não o sigilo dela.
# Manter fora do git ainda é o certo — apenas não é um segredo de servidor.
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon"

# URL da API do projeto.
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
