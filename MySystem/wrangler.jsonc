// Cloudflare Workers (static assets): publica o build do Vite (dist/) como SPA.
// Deploy: `npm run deploy` (precisa de `npx wrangler login` uma vez) ou integração Git no painel da Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mysystem",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Rotas do React Router (/painel, /atividades/...) caem no index.html.
    "not_found_handling": "single-page-application"
  }
}
